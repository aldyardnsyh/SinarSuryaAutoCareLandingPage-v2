---
// BaseLayout — <head>, SEO meta, OG/Twitter card, JSON-LD AutoRepair, font loading.
import '@fontsource/anton';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/tokens.css';
import { SITE, SITE_URL, MAPS_EMBED_URL } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  /** Path halaman untuk canonical & og:url (mis. '/cuci-mobil-hidrolik'). */
  path?: string;
  /** Judul kartu share (OG/Twitter). Default: judul generik situs. */
  ogTitle?: string;
  /** Deskripsi kartu share (OG/Twitter). Default: deskripsi generik situs. */
  ogDescription?: string;
}

const {
  title = 'Cuci Mobil Hidrolik & Bengkel Mobil Bandung | Sinar Surya Auto Care',
  description = 'Sinar Surya Auto Care, bengkel mobil & cuci hidrolik di Jl. Cijagra No.8, Bojongsoang, Bandung Selatan. Servis rutin, ganti oli, AC, kaki-kaki, cuci kolong hidrolik & steam wash. Chat WhatsApp untuk harga.',
  path = '/',
  ogTitle = 'Cuci Mobil Hidrolik & Bengkel Mobil Bandung - Sinar Surya Auto Care',
  ogDescription = 'Servis rutin, perbaikan, sampai cuci mobil hidrolik di Jl. Cijagra No.8, Bojongsoang, Kabupaten Bandung.',
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL('/og-image.jpg', SITE_URL).href;
const logoUrl = new URL('/logo-512.png', SITE_URL).href;

// JSON-LD dari data listing Google Maps resmi (alamat, geo, jam operasional).
// sameAs: sosial media bengkel + dua domain keluarga lain (satu usaha yang sama).
const sameAs = [
  SITE.social.facebook,
  SITE.social.instagram,
  'https://www.sinarsuryaautocare.biz.id',
  'https://www.bengkelmobilbojongsoang.web.id',
].filter(Boolean);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#141414" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Sinyal lokasi untuk mesin pencari -->
    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content="Bojongsoang, Kabupaten Bandung" />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

    <!-- Open Graph / preview share WhatsApp & Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mobil diangkat lift hidrolik di Sinar Surya Auto Care Bojongsoang" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Ikon: ico untuk Googlebot/tab, PNG 48 fallback SERP, SVG modern, iOS home-screen -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AutoRepair',
      '@id': `${SITE_URL}/#business`,
      name: SITE.name,
      alternateName: 'SSAC',
      description: 'Bengkel mobil dan cuci hidrolik di Bojongsoang, Kabupaten Bandung. Servis rutin, ganti oli, service AC, kaki-kaki, kelistrikan, cuci mobil hidrolik (kolong), steam wash, vacuum dan detailing.',
      url: SITE_URL,
      logo: logoUrl,
      telephone: SITE.phoneIntl,
      priceRange: 'IDR',
      paymentAccepted: 'Tunai, QRIS',
      areaServed: ['Bojongsoang', 'Dayeuhkolot', 'Baleendah', 'Buahbatu', 'Kabupaten Bandung'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: 'Bojongsoang',
        addressRegion: SITE.address.region,
        postalCode: SITE.address.postalCode,
        addressCountry: 'ID',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: SITE.geo.lat,
        longitude: SITE.geo.lng,
      },
      ...(sameAs.length ? { sameAs } : {}),
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '07:00',
          closes: '17:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday'],
          opens: '08:00',
          closes: '16:00',
        },
      ],
      image: [ogImage, new URL('/images/hero-bengkel-cuci-hidrolik-bojongsoang.webp', SITE_URL).href],
      hasMap: SITE.mapsShortLink,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Layanan Sinar Surya Auto Care',
        itemListElement: [
          'Servis Rutin & Tune Up',
          'Ganti Oli & Filter',
          'Service AC Mobil',
          'Kaki-kaki & Rem',
          'Kelistrikan & Aki',
          'Cuci Mobil Hidrolik',
          'Steam Wash Interior',
          'Vacuum & Detailing',
        ].map((nama) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: nama },
        })),
      },
    })} />

    <!-- Schema WebSite: agar Google menampilkan nama brand (bukan domain)
         sebagai nama situs di hasil pencarian. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: SITE.name,
      alternateName: SITE.shortName,
      url: SITE_URL,
      publisher: { '@id': `${SITE_URL}/#business` },
      inLanguage: 'id-ID',
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
