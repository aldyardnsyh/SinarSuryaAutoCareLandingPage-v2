---
// TrustStrip — 4 poin identitas
const points = [
  {
    judul: 'Teknisi Berpengalaman',
    teks: 'Dikerjakan oleh mekanik yang paham mobil Anda.',
  },
  {
    judul: 'Pelayanan Cepat & Ramah',
    teks: 'Datang sesuai jadwal, dikerjakan dengan teliti.',
  },
  {
    judul: 'Sparepart Berkualitas',
    teks: 'Kami rekomendasikan sparepart yang tepat untuk mobil Anda.',
  },
  {
    judul: 'Cuci Hidrolik & Steam',
    teks: 'Bersih sampai bagian bawah mobil.',
  },
];
---

<section class="trust" aria-label="Keunggulan kami">
  <div class="container trust-grid">
    {
      points.map((p, i) => (
        <div class="item">
          <span class="num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{p.judul}</h3>
          <p>{p.teks}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    border-bottom: 1px solid var(--color-zinc);
    padding-block: var(--space-lg);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-accent);
    line-height: 1;
  }
  h3 {
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }
  p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
