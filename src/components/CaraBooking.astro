---
// CaraBooking — 3 langkah, angka outline raksasa
const steps = [
  {
    judul: 'Chat WhatsApp',
    teks: 'Kirim keluhan & foto mobil Anda.',
  },
  {
    judul: 'Konsultasi',
    teks: 'Kami cek dan jelaskan estimasi.',
  },
  {
    judul: 'Datang & Servis',
    teks: 'Kerjakan sesuai jadwal yang disepakati.',
  },
];
---

<section class="booking container" id="cara-booking">
  <p class="eyebrow">02 - Cara Booking</p>
  <h2>Gampang, Cuma 3 Langkah</h2>

  <ol class="steps">
    {
      steps.map((s, i) => (
        <li>
          <span class="num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{s.judul}</h3>
          <p>{s.teks}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .booking {
    padding-block: var(--space-xl);
  }
  h2 {
    font-size: var(--h2);
    margin: var(--space-xs) 0 var(--space-lg);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  li {
    position: relative;
    padding: var(--space-lg);
    background: var(--color-panel);
    border: 1px solid var(--color-zinc);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  li:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-accent);
  }
  .num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-zinc);
    margin-bottom: var(--space-sm);
    user-select: none;
  }
  li:hover .num {
    -webkit-text-stroke-color: var(--color-accent);
  }
  h3 {
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
