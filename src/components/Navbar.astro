---
// Navbar — sticky, hitam, hamburger mobile via ~10 baris vanilla JS
// Anchor menuju section homepage: dari halaman sub-path dipakai "/#anchor".
import Logo from './Logo.astro';
import { SITE, waLink } from '../data/site';

const base = Astro.url.pathname === '/' ? '' : '/';
const menu = [
  { href: `${base}#beranda`, label: 'Beranda' },
  { href: `${base}#tentang`, label: 'Tentang' },
  { href: `${base}#layanan`, label: 'Layanan' },
  { href: `${base}#galeri`, label: 'Galeri' },
  { href: `${base}#kontak`, label: 'Kontak' },
];
---

<header class="navbar">
  <div class="container nav-inner">
    <a href={`${base}#beranda`} class="brand" aria-label={`${SITE.name}, kembali ke atas`}>
      <Logo size={32} />
      <span class="brand-text">
        <strong>{SITE.shortName}</strong>
        <small>Sinar Surya Auto Care</small>
      </span>
    </a>

    <nav aria-label="Navigasi utama">
      <ul class="menu" id="nav-menu">
        {
          menu.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="btn btn-primary btn-book"
      href={waLink('saya mau booking jadwal servis atau cuci mobil. Mobil saya [merek/tipe], rencananya [hari/tanggal].')}
      target="_blank"
      rel="noopener noreferrer"
      >Booking</a
    >

    <button
      class="hamburger"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Buka menu navigasi"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(20, 20, 20, 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-zinc);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    height: 4.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .brand-text small {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .menu {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-muted);
    padding: 0.4rem 0;
    transition: color 0.15s ease;
  }
  .menu a:hover {
    color: var(--color-accent);
  }
  .btn-book {
    margin-left: auto;
    padding: 0.55rem 1.2rem;
    font-size: 0.95rem;
  }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 1px solid var(--color-zinc);
    border-radius: var(--radius);
    padding: 0.6rem;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
  }

  @media (max-width: 900px) {
    .hamburger {
      display: flex;
    }
    .menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-base);
      border-bottom: 1px solid var(--color-zinc);
      display: none;
    }
    .menu.open {
      display: flex;
    }
    .menu a {
      display: block;
      padding: 0.9rem var(--gutter);
      border-top: 1px solid var(--color-zinc);
    }
  }
  @media (max-width: 480px) {
    .btn-book {
      display: none;
    }
  }
</style>

<script>
  // Hamburger — toggle class (vanilla)
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
    toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
  });
  // Tutup menu setelah anchor diklik
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
