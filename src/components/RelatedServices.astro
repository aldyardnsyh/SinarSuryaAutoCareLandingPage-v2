---
// RelatedServices — tautan silang antar halaman layanan/artikel di akhir
// halaman (internal linking). Dipasang sebelum CtaBand pada halaman layanan.
interface Item {
  href: string;
  label: string;
  desc: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section class="related container" aria-label="Layanan terkait">
  <p class="related-eyebrow">Layanan Terkait</p>
  <div class="grid">
    {
      items.map((item) => (
        <a class="card" href={item.href}>
          <span class="label">{item.label}</span>
          <span class="desc">{item.desc}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .related {
    padding-block: var(--space-lg);
  }
  .related-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-md);
    background: var(--color-panel);
    border: 1px solid var(--color-zinc);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--color-accent);
  }
  .label {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .desc {
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .arrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    margin-top: 0.2rem;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
