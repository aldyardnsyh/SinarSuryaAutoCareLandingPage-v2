---
// SplitShowcase — dua panel besar berdampingan
// Foto asli bengkel dari listing Google Maps.
import { waLink } from '../data/site';
---

<section class="showcase container" aria-label="Dua layanan utama kami">
  <div class="panel left">
    <img
      src="/images/split-bengkel-servis-mobil.webp"
      alt="Mekanik Sinar Surya Auto Care mengerjakan mobil di atas lift di area servis bengkel Bojongsoang"
      width="1400"
      height="1000"
      loading="lazy"
    />
    <div class="content">
      <span class="tag">Bengkel - Perbaikan &amp; Servis</span>
      <h3>Keluhan dicek dulu, baru dikerjakan</h3>
      <a class="btn btn-primary" href={waLink('mobil saya ada keluhan [jelaskan keluhannya]. Mohon dibantu dicek.')} target="_blank" rel="noopener noreferrer"
        >Konsultasi Servis</a
      >
    </div>
  </div>

  <div class="panel right">
    <img
      src="/images/split-cuci-mobil-hidrolik.webp"
      alt="Mobil diberi busa sabun saat dicuci di Sinar Surya Auto Care, cuci mobil hidrolik Bojongsoang"
      width="1400"
      height="1000"
      loading="lazy"
    />
    <div class="content">
      <span class="tag">Cuci Hidrolik - Steam &amp; Vacuum</span>
      <h3>Bersih sampai bagian bawah mobil</h3>
      <a class="btn btn-primary" href={waLink('saya mau reservasi cuci hidrolik untuk mobil saya. Hari ini masih bisa masuk jadwal?')} target="_blank" rel="noopener noreferrer"
        >Reservasi Cuci Hidrolik</a
      >
    </div>
  </div>
</section>

<style>
  .showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }
  .panel {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid var(--color-zinc);
    border-radius: var(--radius);
    isolation: isolate;
  }
  .panel img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .panel:hover img {
    transform: scale(1.04);
  }
  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(20, 20, 20, 0.96) 22%, rgba(20, 20, 20, 0.35) 70%);
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--color-base);
    border: 1px solid var(--color-zinc);
    color: var(--color-accent);
    padding: 0.3rem 0.7rem;
  }
  .content h3 {
    font-size: var(--h3);
    max-width: 18ch;
  }
  @media (max-width: 820px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .panel {
      min-height: 340px;
    }
  }
</style>
